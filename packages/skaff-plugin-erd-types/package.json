{
  "name": "@timonteutelink/skaff-plugin-erd-types",
  "version": "0.0.1",
  "description": "Type-only helpers for the ERD Skaff plugin",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "bun run build"
  },
  "dependencies": {
    "@timonteutelink/template-types-lib": "workspace:*",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
