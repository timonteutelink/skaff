{
  "name": "@timonteutelink/skaff-plugin-erd",
  "version": "0.0.1",
  "description": "Prototype ERD template plugin for Skaff",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "oclif": {
