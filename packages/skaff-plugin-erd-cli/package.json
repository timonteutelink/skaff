{
  "name": "@timonteutelink/skaff-plugin-erd-cli",
  "version": "0.0.1",
  "description": "CLI contribution for the Skaff ERD plugin",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "oclif": {
    "name": "@timonteutelink/skaff-plugin-erd-cli"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "bun run build"
  },
  "dependencies": {
    "@timonteutelink/skaff-lib": "workspace:*",
    "@timonteutelink/skaff-plugin-erd": "workspace:*",
    "@timonteutelink/skaff-plugin-erd-types": "workspace:*"
  },
  "skaff": {
    "manifest": {
      "name": "erd",
      "version": "0.0.1",
      "capabilities": [
        "cli"
      ],
      "supportedHooks": {
        "template": [],
        "cli": [],
        "web": []
      }
    }
  },
  "devDependencies": {
    "@inquirer/prompts": "^5.3.8",
    "typescript": "5.9.3"
  }
}
