{
  "name": "@timonteutelink/skaff-lib",
  "version": "0.0.99",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timonteutelink/skaff.git",
    "directory": "packages/skaff-lib"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "bun run test:ci",
    "test:ci": "cd ../template-types-lib && bun run build && cd ../../examples/plugins/plugin-greeter-types && bun run build && cd ../../../packages/skaff-lib && bun run build && jest",
    "test:watch": "jest --watch"
  },
  "devDependencies": {
    "@swc/jest": "^0.2.39",
    "@types/bun": "^1.3.5",
    "@types/fs-extra": "^11.0.4",
    "@types/semver": "^7.7.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-only-warn": "^1.1.0",
    "jest": "^30.2.0",
    "ts-node": "^10.9.2",
    "typescript-eslint": "^8.52.0"
  },
  "dependencies": {
    "@endo/module-source": "^1.3.3",
    "@timonteutelink/template-types-lib": "workspace:*",
    "@types/node": "^25.0.3",
    "esbuild": "^0.27.2",
    "fs-extra": "^11.3.3",
    "glob": "^13.0.0",
    "handlebars": "^4.7.8",
    "loglevel": "^1.9.2",
    "semver": "^7.7.3",
    "ses": "^1.14.0",
    "simple-git": "^3.30.0",
    "typescript": "5.9.3",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "yaml": "^2.8.2",
    "zod": "^4.3.5"
  }
}
