{
  "name": "@timonteutelink/template-types-lib",
  "version": "0.0.56",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timonteutelink/skaff.git",
    "directory": "packages/template-types-lib"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "test": "bun run lint && bun run check-types"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-only-warn": "^1.1.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.52.0",
    "handlebars": "^4.7.8",
    "zod": "^4.3.5"
  },
  "peerDependencies": {
    "handlebars": "^4.7.8",
    "zod": "^4.1.12"
  }
}
